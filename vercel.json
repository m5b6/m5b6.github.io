{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/canvas/events/route.ts": {
      "maxDuration": 300
    },
    "app/api/asylum/events/route.ts": {
      "maxDuration": 300
    },
    "app/api/mcp/route.ts": {
      "maxDuration": 60
    },
    "app/api/asylum/mcp/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/asylum/tick",
      "schedule": "0 * * * *"
    }
  ]
}
